"app01\stm32f1xx_hal_spi.o"
"app01\stm32f1xx_hal.o"
"app01\stm32f1xx_hal_rcc.o"
"app01\stm32f1xx_hal_rcc_ex.o"
"app01\stm32f1xx_hal_gpio.o"
"app01\stm32f1xx_hal_dma.o"
"app01\stm32f1xx_hal_cortex.o"
"app01\stm32f1xx_hal_pwr.o"
