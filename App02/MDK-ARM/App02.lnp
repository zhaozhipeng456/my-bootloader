".\gpio.o"
".\spi.o"
".\usart.o"
".\stm32f1xx_it.o"
".\stm32f1xx_hal_msp.o"
".\stm32f1xx_hal_gpio_ex.o"
".\stm32f1xx_hal_spi.o"
".\stm32f1xx_hal.o"
".\stm32f1xx_hal_rcc.o"
".\stm32f1xx_hal_rcc_ex.o"
".\stm32f1xx_hal_gpio.o"
".\stm32f1xx_hal_dma.o"
".\stm32f1xx_hal_cortex.o"
".\stm32f1xx_hal_pwr.o"
".\stm32f1xx_hal_flash.o"
